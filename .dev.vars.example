# Copy to `.dev.vars` for `wrangler dev` / Vite dev (gitignored).
# Bindings DB / ASSETS are provisioned via wrangler.jsonc — no API keys needed.
# Secrets untuk lokal juga taruh di sini (wrangler dev akan load otomatis).

APP_URL=http://localhost:5173
ENVIRONMENT=development
# Untuk dev lokal, generate dummy secrets:
# JWT_SECRET=dev-jwt-secret-min-32-chars-long-please-change
# ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
