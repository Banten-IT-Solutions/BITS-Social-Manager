# Salin ke `.env` untuk development lokal (file .env ter-gitignore).
# Nilai-nilai ini mensubstitusi placeholder ${VAR} di wrangler.template.jsonc
# saat `npm run cf:config` dijalankan (otomatis sebelum dev/build/deploy).
#
# Di CI/CD, nilai yang sama diisi lewat GitHub Secrets — lihat README.
# Konsisten ala BITS-Nota: WORKER_NAME == D1_DATABASE_NAME == bits-social-manager

WORKER_NAME=bits-social-manager
D1_DATABASE_NAME=bits-social-manager
# Salin dari output `wrangler d1 create bits-social-manager`
D1_DATABASE_ID=
APP_URL=https://social.bits.co.id
APP_DOMAIN=social.bits.co.id

# ── Secrets (Worker SECRET, bukan vars) ───────────────────────────────────
# Secret diletakkan via `wrangler secret put`, TIDAK di-commit.
#   JWT_SECRET     : HMAC-SHA256 signing key, minimal 32 karakter
#                    generate: openssl rand -base64 48
#   ENCRYPTION_KEY : AES-256-GCM key, 64 karakter hex (32 byte)
#                    generate: openssl rand -hex 32
# Di CI, validasi format dilakukan tapi TIDAK di-sync otomatis (immutable).
#   Set manual dari mesin lokal (setelah rename worker):
#     npx wrangler secret put JWT_SECRET --name bits-social-manager
#     npx wrangler secret put ENCRYPTION_KEY --name bits-social-manager
