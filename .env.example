# Copy to .env for local development (gitignored).
# Values replace ${VAR} placeholders in wrangler.template.jsonc via `npm run cf:config`.

WORKER_NAME=bits-social-manager
D1_DATABASE_NAME=bits-social-manager
# Get from `wrangler d1 create <name>`
D1_DATABASE_ID=
APP_URL=https://social.bits.co.id
APP_DOMAIN=social.bits.co.id
