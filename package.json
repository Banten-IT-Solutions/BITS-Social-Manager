{
  "name": "bits-social-manager",
  "version": "1.0.0",
  "description": "Secure social account manager for organizing project credentials across teams",
  "keywords": [
    "social",
    "credentials",
    "manager",
    "cloudflare",
    "hono",
    "react",
    "security"
  ],
  "license": "MIT",
  "type": "module",
  "private": true,
  "author": {
    "name": "Banten IT Solutions",
    "email": "admin@bits.co.id",
    "url": "https://bits.co.id"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Banten-IT-Solutions/BITS-Social-Manager.git"
  },
  "bugs": {
    "url": "https://github.com/Banten-IT-Solutions/BITS-Social-Manager/issues"
  },
  "homepage": "https://bits.co.id",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "cf:config": "node scripts/gen-wrangler.mjs",
    "dev": "npm run cf:config && vite",
    "build": "npm run cf:config && vite build",
    "preview": "vite preview",
    "deploy": "npm run build && wrangler deploy",
    "cf:typegen": "wrangler types",
    "db:migrate:local": "npm run cf:config && { [ -f .env ] && . ./.env || true; } && { [ -n \"$D1_DATABASE_NAME\" ] || { echo 'D1_DATABASE_NAME belum diset' && exit 1; }; } && wrangler d1 migrations apply \"$D1_DATABASE_NAME\" --local",
    "db:migrate:remote": "npm run cf:config && { [ -f .env ] && . ./.env || true; } && { [ -n \"$D1_DATABASE_NAME\" ] || { echo 'D1_DATABASE_NAME belum diset' && exit 1; }; } && wrangler d1 migrations apply \"$D1_DATABASE_NAME\" --remote",
    "db:generate": "drizzle-kit generate",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "type-check": "tsc --noEmit && tsc -p tsconfig.worker.json --noEmit",
    "check": "npm run type-check && npm run lint",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "simple-git-hooks"
  },
  "dependencies": {
    "@hono/zod-validator": "^0.9.0",
    "@hookform/resolvers": "^5.9.1",
    "bcryptjs": "^3.0.3",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.13.5",
    "lucide-react": "^1.35.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-hook-form": "^7.86.0",
    "react-router-dom": "^7.18.2",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.54.1",
    "@cloudflare/workers-types": "^5.20260828.1",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/bcryptjs": "^3.0.0",
    "@types/node": "^26.4.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.1",
    "autoprefixer": "^10.5.4",
    "concurrently": "^10.0.5",
    "drizzle-kit": "^0.31.10",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.11.0",
    "lint-staged": "^17.4.1",
    "postcss": "^8.5.26",
    "prettier": "^3.9.6",
    "simple-git-hooks": "^2.13.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vitest": "^4.1.11",
    "wrangler": "^4.127.0"
  },
  "allowScripts": {
    "esbuild@0.25.12": true,
    "esbuild@0.18.20": true,
    "esbuild@0.28.1": true,
    "esbuild@0.28.2": true,
    "simple-git-hooks@2.13.1": true,
    "workerd@1.20260801.1": true,
    "workerd@1.20260826.1": true,
    "workerd@1.20260828.1": true
  },
  "simple-git-hooks": {
    "pre-commit": "npx lint-staged",
    "pre-push": "npm run check && npm run build"
  },
  "lint-staged": {
    "*.{js,ts,tsx,json,css,md}": "prettier --write",
    "*.{js,ts,tsx}": "eslint --fix"
  }
}
